{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mira Beauty: сайт",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "MIRA_PORT": "5019",
        "MIRA_OPEN_BROWSER": "1"
      }
    },
    {
      "name": "Mira Beauty: Python-приложение оператора",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/operator_app.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
